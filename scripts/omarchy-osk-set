#!/bin/bash
# omarchy-osk-set show|hide
# Explicitly show or hide the squeekboard on-screen keyboard via its DBus
# service (as opposed to omarchy-osk-toggle, which flips current state).
# Used both by the manual keybinding and by the dock-keyboard udev hook.

action="$1"
[[ "$action" == "show" || "$action" == "hide" ]] || { echo "usage: $0 show|hide" >&2; exit 1; }

pgrep -x squeekboard >/dev/null || setsid -f squeekboard >/dev/null 2>&1

for _ in $(seq 1 20); do
  busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible >/dev/null 2>&1 && break
  sleep 0.1
done

if [[ "$action" == "show" ]]; then
  busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b true
else
  busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b false
fi
